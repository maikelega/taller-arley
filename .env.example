# Taller Arley — Environment Config
# Copy to .env and fill with local values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taller_arley_dev
DB_USER=root
DB_PASS=password

# App
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Session
SESSION_LIFETIME=1800

# Notificaciones WhatsApp (Fase 1+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Email (opcional, Fase 2+)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
